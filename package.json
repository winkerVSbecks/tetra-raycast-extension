{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "tetra-raycast-extension",
  "title": "Tetra",
  "description": "Utilities to work with Tetra",
  "icon": "tetra-icon-512.png",
  "author": "winkerVSbecks",
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "search-colors",
      "title": "Search Colors",
      "subtitle": "Tetra",
      "keywords": [
        "css"
      ],
      "description": "Search Tetra color tokens",
      "mode": "view"
    },
    {
      "name": "search-breakpoints",
      "title": "Search Breakpoints",
      "subtitle": "Tetra",
      "keywords": [
        "breakpoint",
        "media query"
      ],
      "description": "Search Tetra breakpoint tokens",
      "mode": "view"
    },
    {
      "name": "search-typography-tokens",
      "title": "Search Typography Tokens",
      "subtitle": "Tetra",
      "keywords": [
        "typography",
        "font",
        "family",
        "weight",
        "size",
        "line height"
      ],
      "description": "Search Tetra typography tokens",
      "mode": "view"
    },
    {
      "name": "search-typography-styles",
      "title": "Search Typography Styles",
      "subtitle": "Tetra",
      "keywords": [
        "typography",
        "font",
        "family",
        "weight",
        "size",
        "line height"
      ],
      "description": "Search Tetra typography styles",
      "mode": "view"
    },
    {
      "name": "search-spacing",
      "title": "Search Spacing tokens",
      "subtitle": "Tetra",
      "keywords": [
        "spacing",
        "margin",
        "padding"
      ],
      "description": "Search Tetra spacing tokens",
      "mode": "view"
    }
  ],
  "categories": [
    "Documentation",
    "Developer Tools"
  ],
  "dependencies": {
    "@chromatic-com/tetra": "^3.2.14",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@raycast/api": "^1.104.15",
    "framer-motion": "^11.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
